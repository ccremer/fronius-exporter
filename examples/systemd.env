## IP Address to bind to listen for Prometheus scrapes.
BIND_ADDR=:9089

## Target URL of Fronius Symo device.
SYMO__URL=http://symo.ip.or.hostname

## Enable/disable scraping of archive data
# SYMO__ENABLE_ARCHIVE=true

## Enable/disable scraping of power flow data
# SYMO__ENABLE_POWER_FLOW=true

## Comma-separated List of "key: value" headers to append to the requests going to Fronius Symo. Example: "authorization=Basic <base64>".
# SYMO__HEADER=

## Timeout in seconds when collecting metrics from Fronius Symo. Should not be larger than the scrape interval.
# SYMO__TIMEOUT=5

## Background polling interval in seconds.
# POLL__INTERVAL=10

## Maximum cache age in seconds before /metrics returns stale.
# POLL__FRESH_TIMEOUT=30

## MQTT broker URL. Leave unset to disable MQTT publishing.
# MQTT__BROKER=tcp://mqtt-broker:1883

## MQTT username.
# MQTT__USERNAME=

## MQTT password.
# MQTT__PASSWORD=

## Base topic used for publishing updates.
# MQTT__BASE_TOPIC=fronius-exporter

## MQTT client ID. Leave empty to auto-generate one.
# MQTT__CLIENT_ID=

## Size of the asynchronous MQTT publish queue.
# MQTT__QUEUE_SIZE=16

## MQTT reconnect retry interval in seconds.
# MQTT__RECONNECT_INTERVAL=5

## MQTT availability topic for Home Assistant and LWT.
## Defaults to <MQTT__BASE_TOPIC>/availability.
# MQTT__AVAILABILITY_TOPIC=

## MQTT payload published when exporter is online.
# MQTT__AVAILABILITY_PAYLOAD_UP=online

## MQTT last-will payload published when exporter is offline.
# MQTT__AVAILABILITY_PAYLOAD_DOWN=offline

## Enable Home Assistant MQTT discovery publishing.
# MQTT__DISCOVERY_ENABLED=false

## Home Assistant MQTT discovery prefix.
# MQTT__DISCOVERY_PREFIX=homeassistant

## Home Assistant device name for discovered entities.
# MQTT__DISCOVERY_DEVICE_NAME=Fronius Exporter

## Home Assistant device identifier for discovered entities.
# MQTT__DISCOVERY_DEVICE_ID=fronius-exporter

## CA certificate file for MQTT TLS.
# MQTT__TLS_CA_FILE=

## Client certificate file for MQTT TLS.
# MQTT__TLS_CERT_FILE=

## Client key file for MQTT TLS.
# MQTT__TLS_KEY_FILE=

## Override TLS server name for MQTT.
# MQTT__TLS_SERVER_NAME=

## Skip MQTT TLS certificate verification.
# MQTT__TLS_INSECURE_SKIP_VERIFY=false

## Logging level.
# LOG__LEVEL=info
